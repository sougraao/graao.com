---
// Print da plataforma guardado no R2. `src` é a chave no bucket (docs/<grupo>/<artigo>/<arquivo>).
import { midiaBase } from '../../scripts/midia-base.mjs';

interface Props { src: string; alt: string; legenda?: string }
const { src, alt, legenda } = Astro.props;
if (!alt) throw new Error(`<Print src="${src}"> precisa de alt.`);
const url = `${midiaBase()}/${src}`;
---
<figure class="graao-print">
  <a href={url} target="_blank" rel="noopener"><img src={url} alt={alt} loading="lazy" decoding="async" width="1440" /></a>
  {legenda && <figcaption>{legenda}</figcaption>}
</figure>

<style>
  .graao-print { margin: 1rem 0; }
  .graao-print img { display: block; width: 100%; height: auto; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; }
  .graao-print a { display: block; cursor: zoom-in; }
  .graao-print figcaption { margin-top: 0.4rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
</style>
