{
  "manifest_version": 3,
  "name": "graao: Importar do GHL",
  "version": "1.1.0",
  "description": "Leva uma subconta do GHL (com o snapshot carregado) para o graao como um setup seu. Só lê; nada muda no GHL.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.graao.com/*",
    "https://graao.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Importar para o graao",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
