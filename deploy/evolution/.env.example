# Copiado para .env pelo install.sh, que também gera as senhas. Não versione o .env.

# ---------- Infra (lidas pelo docker-compose.yml) ----------
# Subdomínio apontando (registro A) para o IP da VPS. Ex.: whatsapp.graao.com
DOMAIN=
# E-mail para o certificado HTTPS (Let's Encrypt).
ACME_EMAIL=
POSTGRES_PASSWORD=
TZ=America/Sao_Paulo
# Teto de memória do container da Evolution. Com 8 GB de RAM pode subir para 4g.
EVOLUTION_MEM_LIMIT=2g
# Vigia: checa a cada N segundos e reinicia instância presa em "connecting" após N checagens.
WATCHDOG_INTERVAL=60
WATCHDOG_STUCK_CYCLES=10
# Manutenção diária (maintenance.sh): por quantos dias guardar mensagens e backups.
MESSAGE_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=7

# ---------- Evolution API ----------
SERVER_TYPE=http
SERVER_PORT=8080
LANGUAGE=pt-BR

# Chave global. É o EVOLUTION_API_KEY do graao.app (Vercel). Gerada pelo install.sh.
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
# Nunca apagar sozinha uma instância que ficou desconectada.
DEL_INSTANCE=false

# Nome que aparece em "Aparelhos conectados" no celular.
CONFIG_SESSION_PHONE_CLIENT=Graao
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR="#175197"

LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=false
LOG_BAILEYS=error

# Sessões no Postgres (sobrevivem a reinício). Mensagens novas ficam salvas porque o WhatsApp
# pede reenvio quando o destinatário não consegue decifrar ("Aguardando mensagem").
# Contatos, conversas e histórico não: o graao.app já guarda isso, e economiza disco e RAM.
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_CLIENT_NAME=evolution_graao
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=true

# Redis só como cache. CACHE_REDIS_SAVE_INSTANCES=false mantém as sessões no Postgres.
CACHE_REDIS_ENABLED=true
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# O graao.app registra o webhook de cada instância sozinho; não há webhook global.
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_EVENTS_ERRORS=false

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# Integrações que o graao.app não usa: desligadas para gastar menos memória.
TELEMETRY_ENABLED=false
PROVIDER_ENABLED=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
PUSHER_ENABLED=false
KAFKA_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
TYPEBOT_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
FLOWISE_ENABLED=false
S3_ENABLED=false
PROMETHEUS_METRICS=false
