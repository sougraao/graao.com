# Server configuration. GO_STORAGE_KEY must match the hash in the Supabase RLS policy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
GO_STORAGE_KEY=

# Optional. Override the OpenAI model used with each user's own API key.
STUDIO_OPENAI_MODEL=
# Optional. Enable Places API (New) and Geocoding API in Google Cloud.
PROSPECTING_GOOGLE_PLACES_KEY=
# Optional but recommended. PageSpeed Insights API key for the prospect audit's loading-speed score.
# Without it the shared keyless quota is usually exhausted and speed falls back to a response-time estimate.
PROSPECTING_PAGESPEED_KEY=
# Optional. Use a separate browser key restricted to Maps Embed API and the app's website.
PROSPECTING_GOOGLE_MAPS_EMBED_KEY=

# Optional. UUID of the confirmed Supabase Auth user who owns the shared agency.
GO_AGENCY_OWNER_ID=

# Optional. Send client portal invitations and sign-in links through Resend.
RESEND_API_KEY=
PORTAL_EMAIL_FROM=
# Optional. E-mail recebido: domínio com o MX apontado para a Resend (recebimento). Cada subconta recebe em
# conversas+<subconta>@INBOUND_EMAIL_DOMAIN, e esse endereço vai como Reply-To dos e-mails da equipe e dos fluxos.
# Na Resend, crie o webhook email.received para https://<seu domínio>/api/email/inbound e cole o segredo whsec_ aqui.
INBOUND_EMAIL_DOMAIN=
RESEND_INBOUND_SECRET=
PORTAL_PUBLIC_ORIGIN=https://graao.com

# Optional. Telefonia (Twilio): a conta da plataforma compra os números das subcontas (Configurações → Telefonia),
# liga, grava e consulta números (Lookup). PHONE_PUBLIC_ORIGIN é o endereço público que a Twilio chama
# (/api/phone/twilio/*, assinado com o Auth Token). Números do Brasil pedem um Regulatory Bundle aprovado na Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PHONE_PUBLIC_ORIGIN=https://graao.com
TWILIO_BUNDLE_SID=
TWILIO_ADDRESS_SID=

# Optional. Notificações push (app mobile white-label e portal do cliente): gere com node scripts/vapid-keys.mjs.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:suporte@graao.com

# WhatsApp gerenciado pela plataforma: o servidor Evolution API da VPS (veja deploy/evolution/README.md).
# Com estas duas preenchidas, toda subconta conecta o número só lendo o QR Code, sem a agência digitar nada.
# EVOLUTION_API_KEY é o mesmo valor de AUTHENTICATION_API_KEY do .env da VPS.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=

# Local development only.
# GO_PORT=4317
# GO_DB_PATH=.data/go.sqlite
# GO_DEV_NO_AUTH=1
# With SQLite the server runs the one-minute scheduler (automations, posts, campaigns). With Supabase it stays off,
# because the official cron already calls /api/social/cron. Set to 1 only to run it from this process too. Ignored on Vercel.
# GO_LOCAL_SCHEDULER=1

# Social planner. On Vercel, call GET /api/social/cron every minute with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Public origin used for media URLs and OAuth callbacks, e.g. https://app.example.com
SOCIAL_PUBLIC_URL=
# Token encryption key. Defaults to a key derived from GO_STORAGE_KEY.
SOCIAL_TOKEN_KEY=
# Optional API version overrides.
# META_GRAPH_VERSION=v23.0
# LINKEDIN_API_VERSION=202510

# Social network apps. Leave a pair empty to disable that network.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Messenger and Instagram Direct: in the Meta app, subscribe the "page" (messages) and "instagram" (messages)
# webhooks to https://<SOCIAL_PUBLIC_URL>/api/meta/webhook with this verify token. Signatures use META_APP_SECRET.
# The app needs pages_messaging, pages_manage_metadata and instagram_manage_messages (App Review for production).
META_WEBHOOK_VERIFY_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API (Marketing → Anúncios and the workflow offline conversions): the developer token from the
# Google Ads API Center is required on every call; the login customer ID only when access comes through a manager account.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Optional. Cloudflare R2 (S3-compatible) for Mídia Drive files over 700 KB (up to 50 MB) and videos
# (testimonials and AI-generated). Create an R2 API token with "Object Read & Write" on the bucket, then
# allow the app's origins once: node --env-file=.env.local scripts/r2-cors.mjs https://<app-domain>
# Leave all four empty to keep files inline in the database (700 KB limit). R2_JURISDICTION: eu or fedramp.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_JURISDICTION=

# Central de documentação (doc.graao.com): bucket público do R2 com prints e vídeos (midia.graao.com).
# R2_DOCS_ACCOUNT_ID=
# R2_DOCS_ACCESS_KEY_ID=
# R2_DOCS_SECRET_ACCESS_KEY=
# R2_DOCS_BUCKET=graao-docs-midia

# Optional. graao AI Gateway (painel Plataforma → AI Gateway, só o dono). Cada provedor só entra na rota quando
# a chave existe aqui E o dono liga o provedor no painel. Sem nenhuma, tudo segue como antes (chave OpenAI da agência).
# As chaves nunca passam pelo painel nem voltam nas respostas: o painel mostra só os 4 últimos caracteres.
# OPENAI_API_KEY e GEMINI_API_KEY já servem o "Pergunte à Graao" (graao-chat.mjs); o gateway só as usa com o provedor ligado.
# Grupo A (camadas gratuitas, gratuidade só vale depois de confirmada no painel):
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Grupo B (pagos; nada pago roda sem orçamento definido no painel):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
# Grupo C: servidor próprio compatível com a API da OpenAI (só https público; a URL passa pela proteção contra SSRF).
GRAAO_AI_COMPAT_BASE_URL=
GRAAO_AI_COMPAT_API_KEY=
