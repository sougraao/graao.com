{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "regions": ["gru1"],
  "schedules": {
    "social-publisher": {
      "schedule": "*/15 * * * *",
      "path": "/api/social/cron",
      "requestMethod": "GET"
    }
  },
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{ui/**,setup-templates/**}"
    },
    "server.mjs": {
      "includeFiles": "{ui/**,setup-templates/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs?__path=/$1"
    }
  ]
}
